.page {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: var(--sh-raise);
}

.page-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--c-text);
  margin-bottom: 12rpx;
  text-align: center;
}

.page-subtitle {
  font-size: 24rpx;
  color: var(--c-text-2);
  line-height: 1.55;
  margin-bottom: 20rpx;
  text-align: center;
}

/* 闂傚鍓﹂崑鍌炲船?tab */
.identity-tabs {
  display: flex;
  background: var(--c-quiet-bg);
  border-radius: 999rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.identity-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: var(--c-quiet);
}

.tab-on {
  background: #ffffff;
  color: var(--c-text);
  font-weight: 700;
  box-shadow: var(--sh-near);
}

/* 缂備焦绋戦ˇ顖滄?*/
.waiting-card {
  text-align: center;
  padding: 60rpx 24rpx;
}

.waiting-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--c-text);
  margin-bottom: 16rpx;
}

.waiting-desc {
  font-size: 26rpx;
  color: var(--c-text-sub);
  line-height: 1.6;
  margin-bottom: 8rpx;
}

/* 闁荤偞绋忛崝灞界暦?*/
.form-section {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--c-text);
  margin-bottom: 16rpx;
  margin-top: 20rpx;
}

.form-section:first-of-type {
  margin-top: 0;
}

.input {
  width: 100%;
  min-height: 88rpx;
  background: var(--c-ink);
  border: none;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: var(--c-text);
  margin-bottom: 20rpx;
}

.placeholder {
  color: var(--c-placeholder);
  font-size: 24rpx;
}

.form-hint {
  font-size: 24rpx;
  color: var(--c-text-sub);
  margin-bottom: 20rpx;
}

/* 闂佸湱顭堥ˇ鐢稿箰?*/
.primary-btn {
  width: 100%;
  min-height: 72rpx;
  border-radius: 999rpx;
  background: var(--c-pink);
  color: #ffffff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24rpx;
  white-space: nowrap;
}

.btn-hover {
  background: var(--c-pink-deep);
  opacity: 0.8;
}

/* 闂佸憡姊绘慨鎾矗?*/
.join-guide-name {
  font-size: 28rpx;
  color: var(--c-text);
  font-weight: 600;
  margin-bottom: 24rpx;
  text-align: center;
}

.join-names {
  margin-bottom: 20rpx;
}

.join-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.04);
}

.join-label {
  font-size: 24rpx;
  color: var(--c-text-sub);
}

.join-value {
  font-size: 28rpx;
  color: var(--c-text);
  font-weight: 600;
}

.join-hint {
  font-size: 24rpx;
  color: var(--c-text-sub);
  margin-bottom: 24rpx;
  text-align: center;
}

/* 闂佸搫鍟悥鐓幬涚捄銊﹀皫濡炲楠告禒顖炴⒑椤愩埄妲归悗姘ュ姂閺佸秴顫㈤惍顦奿o 婵炴垶鎸撮崑鎾绘偠濞戞瀚伴柤鑽ゅ枛楠炴帡骞掗悙鐢殿槷闁诲孩绋掗〃鍛般亹閸ф瑙﹂悘鐐村劤缁插湱绱掗埀?*/
.radio-label {
  font-size: 24rpx;          /* 闂佸憡绮岀悮顐﹀焵椤掆偓閺堫剟宕楅崒娑氶檮闁瑰瓨甯為崯濠囨煕閹邦剛孝闁挎繄鍋ゆ俊鏉戭吋閸曨収浼囬梺?*/
  color: var(--c-text);
  margin-right: 32rpx;
}

radio-group radio {
  transform: scale(0.7);     /* 缂傚倸鍊甸弲娑㈡儍椤掑嫬鎹堕柛鈩冪懃娴狀垶鏌ㄥ☉妯垮閻忓浚鍣ｉ弻濠傤吋閸偅鏂€婵?*/
  color: var(--c-pink);            /* 缂備緡鍠栭ˇ顔锯偓闈涙湰閿?*/
}

/* 闂佸搫鍟ㄩ崕鎻掞耿閿熺姵鐒诲璺侯儏椤忋儲淇婂Δ鈧Λ瀵告閺夋鍤曢柣鐔告緲濮ｅ鏌涢幘宕囆㈤柣顐㈢Ф缁牓宕崟顓犘梺鍛婃尭缁夋挳鍩€椤掑倶鈧妲愬┑鍥┾枖?.input 闂佸憡鑹鹃張顒勵敄濞嗘劕绶為柡宥庡墻濞?*/
.picker-display {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  background: var(--c-ink);
  border: none;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: var(--c-text);
  margin-bottom: 20rpx;
  margin-top: 8rpx;
}
