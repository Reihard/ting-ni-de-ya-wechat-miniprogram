.page {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 24rpx;
}

.page-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--c-pink-deep);
  margin-bottom: 8rpx;
}

.ledger-heart {
  color: var(--c-pink);
  margin-right: 4rpx;
}

.page-subtitle {
  font-size: 24rpx;
  color: var(--c-text-2);
  line-height: 1.5;
  margin-bottom: 24rpx;
}

.ledger-list {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 8rpx 24rpx;
  box-shadow: var(--sh-raise);
}

.ledger-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.04);
}

.ledger-item:last-of-type {
  border-bottom: none;
}

.ledger-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.ledger-label {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: var(--c-pink-light);
  color: var(--c-tag-text);
}

.ledger-amount {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--c-pink-deep);
}

.ledger-amount-minus {
  color: var(--c-text-sub);
}

.ledger-amount-plus {
  color: var(--c-pink-deep);
}

.ledger-title {
  font-size: 28rpx;
  color: var(--c-text);
  line-height: 1.5;
  margin-bottom: 6rpx;
  word-break: break-all;
}

.ledger-date {
  font-size: 22rpx;
  color: var(--c-text-sub);
}

.ledger-empty {
  font-size: 24rpx;
  color: var(--c-text-sub);
  padding: 60rpx 0;
  text-align: center;
}
