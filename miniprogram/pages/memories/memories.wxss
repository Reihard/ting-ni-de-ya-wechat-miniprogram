.page {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 24rpx;
  font-size: 28rpx;
}

.hero-card {
  background: var(--c-hero);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--sh-raise);
  color: var(--c-hero-ink);
}

.hero-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.hero-subtitle {
  font-size: 24rpx;
  color: var(--c-text-2);
  line-height: 1.55;
}

.card {
  background: var(--c-card);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: var(--sh-raise);
}

.memory-card {
  margin-bottom: 24rpx;
}

.disband-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--c-text);
  margin-bottom: 20rpx;
}

.disband-text {
  font-size: 24rpx;
  color: var(--c-text-2);
  line-height: 1.55;
}

.disband-input {
  width: 100%;
  height: 72rpx;
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 14rpx 24rpx;
  background: var(--c-ink);
  border-radius: 18rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--c-text);
}

.disband-placeholder {
  color: var(--c-placeholder);
  font-size: 24rpx;
  line-height: 1.4;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--c-text);
  margin-bottom: 20rpx;
}

.card-text,
.step {
  font-size: 24rpx;
  color: var(--c-text-2);
  line-height: 1.55;
}

.step-title {
  font-size: 24rpx;
  color: var(--c-text);
  margin-top: 24rpx;
  margin-bottom: 8rpx;
}

.memory-btn {
  width: 100%;
  min-height: 72rpx;
  border-radius: var(--r-pill);
  margin-top: 24rpx;
  padding-left: 0;
  padding-right: 0;
  font-size: 24rpx;
  line-height: 1.4;
  white-space: nowrap;
  display: flex;
  align-items: center;
  justify-content: center;
}

.memory-btn-primary {
  background: var(--c-pink);
  color: var(--c-ink);
}

.memory-btn-secondary {
  background: var(--c-tint);
  color: var(--c-text-deep);
  border: 2rpx solid var(--c-line);
}

.explain-card {
  margin-bottom: 0;
}

.manual-box,
.preview-box {
  margin-top: 24rpx;
  padding: 20rpx;
  background: var(--c-ink);
  border-radius: 18rpx;
}

.manual-hint,
.preview-text,
.preview-warn {
  font-size: 24rpx;
  color: var(--c-text-2);
  line-height: 1.6;
}

.manual-hint,
.preview-warn {
  color: var(--c-pink-900);
}

.manual-input {
  width: 100%;
  height: 160rpx;
  box-sizing: border-box;
  padding: 16rpx;
  margin-top: 12rpx;
  background: var(--c-card);
  border-radius: 14rpx;
  font-size: 24rpx;
}

.preview-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--c-text);
  margin-bottom: 8rpx;
}

.preview-actions {
  display: flex;
  gap: 16rpx;
}

.preview-actions .memory-btn {
  flex: 1;
}
