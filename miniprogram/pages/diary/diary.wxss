.page {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 24rpx;
}

.page-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--c-text);
  margin-bottom: 24rpx;
}

.write-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--sh-raise);
}

.reply-context {
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: var(--c-card-active);
  color: var(--c-text);
}

.reply-context-title {
  font-size: 26rpx;
  font-weight: 700;
}

.reply-context-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.write-input {
  width: 100%;
  min-height: 120rpx;
  background: var(--c-ink);
  border: none;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: var(--c-text);
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.primary-btn {
  width: 100%;
  min-height: 72rpx;
  border-radius: 999rpx;
  background: var(--c-pink);
  color: #ffffff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--c-text);
  margin-bottom: 16rpx;
  margin-top: 8rpx;
}

.diary-group {
  margin-bottom: 24rpx;
}

.diary-mine {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.diary-theirs {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.diary-entry {
  max-width: 80%;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  box-sizing: border-box;
}

.diary-mine .diary-entry {
  background: var(--c-pink-light);
  border-top-right-radius: 6rpx;
}

.diary-theirs .diary-entry {
  background: #ffffff;
  box-shadow: var(--sh-near);
  border-top-left-radius: 6rpx;
}

.entry-content {
  font-size: 28rpx;
  color: var(--c-text);
  line-height: 1.6;
  margin-bottom: 8rpx;
  word-break: break-all;
}

.diary-mine .entry-time {
  text-align: right;
}

.entry-time {
  font-size: 22rpx;
  color: var(--c-text-sub);
}

.entry-empty {
  font-size: 24rpx;
  color: var(--c-text-sub);
  padding: 24rpx 0;
}
