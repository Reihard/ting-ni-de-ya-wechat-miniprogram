.page {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 24rpx;
}

.hero-card {
  background: var(--c-hero);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--sh-raise);
  color: var(--c-hero-ink);
}

.hero-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.hero-subtitle {
  font-size: 24rpx;
  color: var(--c-text-2);
  line-height: 1.55;
}

.form-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: var(--sh-raise);
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--c-text);
  margin-bottom: 20rpx;
  margin-top: 24rpx;
}

.section-title:first-of-type {
  margin-top: 0;
}

.input {
  width: 100%;
  min-height: 88rpx;
  background: var(--c-ink);
  border: none;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: var(--c-text);
  margin-bottom: 20rpx;
}

.textarea {
  width: 100%;
  min-height: 160rpx;
  background: var(--c-ink);
  border: none;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: var(--c-text);
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.input-placeholder {
  color: var(--c-placeholder);
  font-size: 24rpx;
}

.way-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: var(--c-pink-light);
  color: var(--c-tag-text);
  font-size: 26rpx;
  margin: 0 12rpx 12rpx 0;
}

.way-tag-on {
  background: var(--c-pink);
  color: #ffffff;
}

.photo-hint {
  font-size: 24rpx;
  color: var(--c-text-sub);
  line-height: 1.5;
  background: var(--c-tint);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.primary-btn {
  width: 100%;
  min-height: 72rpx;
  border-radius: 999rpx;
  background: var(--c-pink);
  color: #ffffff;
  font-size: 28rpx;
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}