.page {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 24rpx;
}

.hero-card {
  background: var(--c-hero);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--sh-raise);
  color: var(--c-hero-ink);
}

.hero-title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.hero-state {
  margin-bottom: 16rpx;
}

.state-tag {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: var(--c-pink-light);
  color: var(--c-tag-text);
  font-size: 24rpx;
}

.hero-desc {
  font-size: 26rpx;
  color: var(--c-text-2);
  line-height: 1.5;
  margin-bottom: 12rpx;
  white-space: pre-line;
}

.hero-score {
  font-size: 24rpx;
  color: var(--c-text-sub);
}

.action-area {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--sh-raise);
}

.action-input {
  width: 100%;
  min-height: 120rpx;
  background: var(--c-ink);
  border: none;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: var(--c-text);
  margin-bottom: 20rpx;
}

.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.edit-area {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--sh-raise);
}

.form-section {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--c-text);
  margin-bottom: 16rpx;
  margin-top: 20rpx;
}

.form-section:first-of-type {
  margin-top: 0;
}

.input,
.textarea {
  width: 100%;
  background: var(--c-ink);
  border: none;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  color: var(--c-text);
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.input {
  min-height: 88rpx;
}

.textarea {
  min-height: 120rpx;
}

.action-btn {
  width: 100%;
  min-height: 72rpx;
  border-radius: 999rpx;
  background: var(--c-pink);
  color: #ffffff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn.ghost {
  background: #ffffff;
  border: 2rpx solid var(--c-line-deep);
  color: var(--c-text-sub);
  margin-top: 16rpx;
}

.soft-copy {
  font-size: 26rpx;
  color: var(--c-text-2);
  line-height: 1.6;
  background: var(--c-tint);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.events-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: var(--sh-raise);
}

.events-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.events-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--c-text);
}

.events-toggle {
  font-size: 24rpx;
  color: var(--c-text-sub);
}

.events-list {
  margin-top: 20rpx;
}

.event-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.04);
}

.event-item:last-of-type {
  border-bottom: none;
}

.event-content {
  font-size: 28rpx;
  color: var(--c-text);
  font-weight: 700;
  line-height: 1.5;
  margin-bottom: 8rpx;
  word-break: break-all;
  white-space: pre-line;  /* 闂佸搫鍊瑰姗€路閸愵喗鏅慨姗嗗亞缁犱粙鏌ｉ敐鍡欐噭鐎规洝灏欓幃鏉跨暆鐎ｎ剛顦柣?\n 闂佹眹鍨婚崰鎰板疾?*/
}

.event-meta {
  font-size: 22rpx;
  color: var(--c-text-sub);
}