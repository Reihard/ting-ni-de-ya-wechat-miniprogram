.page {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 24rpx;
}

.hero-card {
  background: var(--c-hero);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--sh-raise);
  color: var(--c-hero-ink);
}

.hero-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.hero-subtitle {
  font-size: 24rpx;
  color: var(--c-text-2);
  line-height: 1.55;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.filter-tab {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--c-quiet);
  background: var(--c-quiet-bg);
}

.filter-on {
  color: #ffffff;
  background: var(--c-pink);
}

.timeline {
  position: relative;
  margin-bottom: 24rpx;
}

.timeline::before {
  content: "";
  position: absolute;
  left: 24rpx;
  top: 10rpx;
  bottom: 10rpx;
  width: 2rpx;
  background: var(--c-line);
}

.timeline-item {
  position: relative;
  display: flex;
  padding: 0 0 20rpx 0;
}

.timeline-item:last-of-type {
  padding-bottom: 6rpx;
}

.timeline-dot {
  position: relative;
  z-index: 1;
  flex: 0 0 48rpx;
  display: flex;
  justify-content: center;
  padding-top: 22rpx;
}

.timeline-dot::before {
  content: "";
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--c-bg);
  border: 4rpx solid var(--c-pink);
  box-sizing: border-box;
}

.timeline-card {
  flex: 1;
  min-width: 0;
  background: #ffffff;
  border: 2rpx solid var(--c-line);
  border-radius: 20rpx;
  padding: 20rpx 22rpx;
  box-shadow: var(--sh-near);
  box-sizing: border-box;
}

.item-head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 6rpx;
}

.item-type {
  font-size: 22rpx;
  color: var(--c-pink-deep);
  font-weight: 500;
}

.item-icontag {
  font-size: 22rpx;
  color: var(--c-pink);
}

.item-thread-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--c-text);
  margin-bottom: 8rpx;
  word-break: break-all;
}

.item-content {
  font-size: 26rpx;
  color: var(--c-text);
  line-height: 1.5;
  margin-bottom: 10rpx;
  word-break: break-all;
}

.reply-mood-quote {
  margin-top: 10rpx;
  padding: 12rpx 16rpx;
  border-left: 4rpx solid var(--c-line-deep);
  background: var(--c-quiet-bg);
  color: var(--c-text-sub);
  font-size: 22rpx;
  line-height: 1.5;
}

.item-meta {
  font-size: 20rpx;
  color: var(--c-text-sub);
}

.empty {
  font-size: 24rpx;
  color: var(--c-text-sub);
  text-align: center;
  padding: 40rpx 0;
}

.empty-title {
  color: var(--c-text);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.5;
}

.empty-text {
  margin-top: 6rpx;
  color: var(--c-text-sub);
  font-size: 23rpx;
  line-height: 1.5;
}

/* 印记：固定中性时间线，卡片表面跟随当前主题。 */
.timeline::before { display: none; }
.trace-date-group { margin-bottom: 8rpx; }
.trace-date { margin: 26rpx 4rpx 14rpx; color: var(--c-text-sub); font-size: 22rpx; font-weight: 600; }
.trace-lane { position: relative; }
.trace-lane::before { content: ""; position: absolute; left: 24rpx; top: 12rpx; bottom: 20rpx; width: 2rpx; background: #d7cbcd; }
.timeline-item { display: flex; position: relative; padding-bottom: 20rpx; }
.timeline-item:last-child { padding-bottom: 8rpx; }
.timeline-dot { flex: 0 0 48rpx; position: relative; z-index: 1; display: flex; justify-content: center; padding-top: 22rpx; }
.timeline-dot::before { content: ""; width: 20rpx; height: 20rpx; border-radius: 50%; background: var(--c-bg); border: 4rpx solid var(--c-pink); box-sizing: border-box; }
.timeline-item.card .timeline-dot::before { border-color: #bf8135; }
.timeline-item.mood .timeline-dot::before { border-color: #5d9573; }
.timeline-item.journal .timeline-dot::before { border-color: #8876a4; }
.timeline-card { flex: 1; min-width: 0; background: var(--c-card); border: 2rpx solid var(--c-line-soft); border-radius: 20rpx; padding: 20rpx 22rpx; box-shadow: var(--sh-near); }
.item-head { margin-bottom: 8rpx; }
.item-type-chip { display: inline-block; padding: 5rpx 12rpx; border-radius: 8rpx; color: #cb5f79; background: #fff0f3; font-size: 20rpx; line-height: 1.2; }
.timeline-item.card .item-type-chip { color: #a8752e; background: #fff5e8; }
.timeline-item.mood .item-type-chip { color: #4f8466; background: #edf8f0; }
.timeline-item.journal .item-type-chip { color: #796994; background: #f3effa; }
.item-head .item-meta { float: right; padding-top: 5rpx; }
.item-result { color: var(--c-pink-deep); font-size: 24rpx; line-height: 1.45; margin: 4rpx 0 12rpx; }
.timeline-item.card .item-result { color: #a8752e; }
.timeline-item.mood .item-result { color: #4f8466; }
.timeline-item.journal .item-result { color: #796994; }
.event-steps { border-top: 2rpx solid var(--c-line-soft); padding-top: 10rpx; }
.event-step { padding: 8rpx 0; font-size: 22rpx; line-height: 1.45; }
.event-step-head { display: flex; gap: 12rpx; align-items: baseline; }
.event-step-time { flex: 0 0 76rpx; color: var(--c-text-sub); font-size: 20rpx; }
.event-step-label { color: var(--c-text); font-weight: 500; }
.event-step-quote { margin-left: 88rpx; color: var(--c-text-2); word-break: break-all; }
.reply-mood-content { margin-top: 8rpx; padding-top: 8rpx; border-top: 1rpx solid var(--c-line-soft); }
.event-step-meta { margin-left: 88rpx; color: var(--c-text-sub); font-size: 19rpx; margin-top: 2rpx; }
